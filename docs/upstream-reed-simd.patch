+#[inline]
+fn advance_scalar_mode(
+    s: &mut f64,
+    c: &mut f64,
+    cos_inc: f64,
+    sin_inc: f64,
+    phase_inc: f64,
+    amplitude: f64,
+    decay_mult: f64,
+    envelope: &mut f64,
+    jitter_drift: f64,
+    onset: f64,
+) -> f64 {
+    let contrib = amplitude * *s * onset * *envelope;
+    let delta_phase = jitter_drift * phase_inc;
+    let ci = cos_inc - delta_phase * sin_inc;
+    let si = sin_inc + delta_phase * cos_inc;
+    let s_new = *s * ci + *c * si;
+    let c_new = *c * ci - *s * si;
+    *s = s_new;
+    *c = c_new;
+    *envelope *= decay_mult;
+    contrib
+}
