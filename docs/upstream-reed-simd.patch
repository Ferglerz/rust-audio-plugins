+        let mut buf = vec![0.0f64; 8192];
+        reed.render(&mut buf);
+        reed.start_damper(60, 44_100.0);
+        reed.render(&mut buf);
+        buf.iter()
+            .map(|x| x.to_bits())
+            .fold(0u64, |acc, bits| acc.wrapping_mul(16_777_619) ^ bits)
+    }
+
+    #[test]
